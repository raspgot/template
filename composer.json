{
    "name": "gauthier/template",
    "description": "Basic portfolio template",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.0",
        "google/recaptcha": "^1.2",
        "phpmailer/phpmailer": "^6.1"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4.4 || ^7.0.4",
        "filp/whoops": "^2.7",
        "phpunit/phpunit": "^9.5 || ^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint-fix": "phpcbf",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "lint": "Run PHP_CodeSniffer",
        "lint-fix": "Fix coding standard violations automatically",
        "analyse": "Run PHPStan static analysis",
        "check": "Run all quality checks (lint, analyse, test)"
    },
    "authors": [
        {
            "name": "gauthier witkowski",
            "email": "contact@raspgot.fr"
        }
    ]
}
