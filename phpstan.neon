parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - vendor
    ignoreErrors:
        # Ignore missing constants defined in config.php
        - '#Constant (DB_DSN|DB_USERNAME|DB_PASSWORD|VIEWS_PATH|SMTP_HOST|SMTP_USERNAME|SMTP_PASSWORD|SMTP_PORT|SMTP_SECURE|RECAPTCHA_SECRET_KEY|RECAPTCHA_SITE_KEY|MAIL_FROM_ADDRESS|MAIL_FROM_NAME|MAIL_SUBJECT) not found#'
    checkMissingIterableValueType: false
